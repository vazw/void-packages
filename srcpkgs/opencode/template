# Template file for 'opencode'
pkgname=opencode
version=2.0.32
revision=1
archs="x86_64 x86_64-musl aarch64 aarch64-musl"
build_style=fetch
depends="ripgrep"
short_desc="Open source AI coding agent"
maintainer="vazw <vaz@siamstr.com>"
license="MIT"
homepage="https://opencode.ai"
changelog="https://github.com/anomalyco/opencode/releases"
nopie_files="/usr/bin/opencode"
nostrip_files="/usr/bin/opencode"

# Upstream ships only Bun-compiled, self-contained prebuilt binaries
# (source build requires the Bun toolchain, out of scope). Each tarball
# contains a single ELF binary 'opencode' at the archive root.
# Asset naming: opencode-linux-<variant>.tar.gz; the four variants
# correspond exactly to the machines in 'archs' above -- keep the
# case statement and archs list in sync when bumping.
# Upstream Bun binaries ship non-PIE (ELF type EXEC), hence nopie_files
# exempts the single binary from the PIE hardening gate, mirroring the
# cabal-install/darcs/cgrep precedent.
# Stripping rewrites the ELF section layout (section alignment
# 16384 -> 4096), orphaning Bun's embedded module payload -- the
# stripped binary degrades to the bare Bun runtime (self-reports
# 1.4.2, the Bun version v2.0.26 is compiled with) -- hence
# nostrip_files ships it unstripped; consequence:
# no -dbg split, installed size ~200MB.
# v2 binaries are no longer published as GitHub release assets; upstream
# serves them from their own CDN (same filenames and archive layout as
# the v1 GitHub release tarballs).
case "$XBPS_TARGET_MACHINE" in
	x86_64)
		distfiles="https://opencode.ai/files/bin/${version}/opencode-linux-x64.tar.gz
		 https://raw.githubusercontent.com/anomalyco/opencode/v${version}/LICENSE"
		checksum="ba3f5d9dd983f12f06981b5b9eb966c03db63266afab28adc4000bbad6adc33c
		 625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b"
		;;
	x86_64-musl)
		distfiles="https://opencode.ai/files/bin/${version}/opencode-linux-x64-musl.tar.gz
		 https://raw.githubusercontent.com/anomalyco/opencode/v${version}/LICENSE"
		checksum="ddac700355268ca404e83607b8af5bac885a39dbe67fb255184f0f2ad4e78357
		 625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b"
		;;
	aarch64)
		distfiles="https://opencode.ai/files/bin/${version}/opencode-linux-arm64.tar.gz
		 https://raw.githubusercontent.com/anomalyco/opencode/v${version}/LICENSE"
		checksum="c2e4f6c94f2e58a2df99cc647bd37285569600d7435e3796152825d8c9d10382
		 625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b"
		;;
	aarch64-musl)
		distfiles="https://opencode.ai/files/bin/${version}/opencode-linux-arm64-musl.tar.gz
		 https://raw.githubusercontent.com/anomalyco/opencode/v${version}/LICENSE"
		checksum="a7eb0269671b10e09f3ac905b7fbed25518cefc2b51dce1ca5234e25f27dee57
		 625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b"
		;;
	esac

do_install() {
	# build_style=fetch only copies the raw distfiles into wrksrc;
	# the glob matches exactly the one tarball fetched for this arch.
	bsdtar -xf opencode-linux-*.tar.gz
	vbin opencode
	vlicense LICENSE
}
